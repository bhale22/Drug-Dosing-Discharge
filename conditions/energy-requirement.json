            {
              "c": 0,
              "t": "Reduce water  by 5 to 10% each day",
              "b": false
            },
            {
              "c": 3,
              "t": "c/day (= 5%)",
              "b": true
            }
          ],
          [],
          [
            {
              "c": 0,
              "t": "If the patient becomes 5% dehydrated or loses 5% body weight, empty the bladder and check USG.",
              "b": false
            }
          ],
          [
            {
              "c": 0,
              "t": "Administer DDAVP at 4 drops of 100 µg/mL solution either intranasally or into the conjunctival sac.",
              "b": false
            }
          ],
          [
            {
              "c": 0,
              "t": "Hospitalize the patient and check USG in 3 hours.8 If USG is >1.025, the diagnosis is CDI. If USG is <1.025, NDI is the most likely diagnosis",
              "b": false
            }
          ],
          [
            {
              "c": 0,
              "t": "(From VIN DI page:)",
              "b": false
            },
            {
              "c": 1,
              "t": "https://www.vin.com/members/cms/project/defaultadv1.aspx?pid=607&id=4954112",
