{
  "title": "Energy Requirement Calculator",
  "desc": "RER, MER by k factor — dog, Expected water intake — dog, MER by k factor — cat, Expected water intake — cat",
  "icon": "🔥",
  "code": "REF-MER",
  "discharge": "Energy Requirement",
  "species": [
    "dog",
    "cat"
  ],
  "noDischarge": true,
  "bands": {},
  "meds": [
    {
      "id": "rer",
      "sp": "dog",
      "grp": "Resting energy requirement",
      "name": "RER",
      "type": "protocol",
      "chipFn": "(kg,lb)=>R2(70*Math.pow(kg,0.75))+' kcal/day'",
      "bodyFn": "(kg,lb)=>'RER = 70 &times; kg<sup>0.75</sup> = 70 &times; '+R2(kg)+'<sup>0.75</sup> = <strong>'+R2(70*Math.pow(kg,0.75))+' kcal/day</strong><br>Maintenance ER = k &times; RER &mdash; pick the k factor below.'",
      "lineFn": "(kg,lb)=>'resting energy requirement '+R2(70*Math.pow(kg,0.75))+' kcal/day'"
    },
    {
      "id": "mer_dog",
      "sp": "dog",
      "grp": "Drugs",
      "name": "MER by k factor — dog",
      "type": "protocol",
      "chipFn": "(kg,lb)=>'see table'",
      "bodyFn": "(kg,lb)=>{var r=70*Math.pow(kg,0.75);var k=[['Typical neutered pet',1.6],['Weight loss (overweight)',1.0],['Obese prone',1.4],['Weight gain (neutered)',2.0],['Weight gain (intact)',2.2]];return k.map(function(x){return x[0]+' (k='+x[1]+') &rarr; <strong>'+R2(x[1]*r)+' kcal/day</strong>';}).join('<br>');}",
      "lineFn": "(kg,lb)=>'maintenance energy requirement = k x '+R2(70*Math.pow(kg,0.75))+' kcal/day'"
    },
    {
      "id": "water_dog",
      "sp": "dog",
      "grp": "Water intake",
      "name": "Expected water intake — dog",
      "type": "protocol",
      "chipFn": "(kg,lb)=>R2(kg*100)+' ml/day = PU/PD'",
      "bodyFn": "(kg,lb)=>'Water intake is about <strong>1 ml per kcal</strong>.<br>PU/PD threshold is over 100 ml/kg/day = <strong>'+R2(kg*100)+' ml/day</strong> = <strong>'+R2(kg*100/236.6)+' cups/day</strong>.'",
      "lineFn": "(kg,lb)=>'PU/PD threshold '+R2(kg*100)+' ml/day (100 ml/kg/day)'"
    },
    {
      "id": "rer_cat",
      "sp": "cat",
      "grp": "Resting energy requirement",
      "name": "RER",
      "type": "protocol",
      "chipFn": "(kg,lb)=>R2(70*Math.pow(kg,0.75))+' kcal/day'",
      "bodyFn": "(kg,lb)=>'RER = 70 &times; kg<sup>0.75</sup> = <strong>'+R2(70*Math.pow(kg,0.75))+' kcal/day</strong><br>Maintenance ER = k &times; RER &mdash; pick the k factor below.'",
      "lineFn": "(kg,lb)=>'resting energy requirement '+R2(70*Math.pow(kg,0.75))+' kcal/day'"
    },
    {
      "id": "mer_cat",
      "sp": "cat",
      "grp": "Drugs",
      "name": "MER by k factor — cat",
      "type": "protocol",
      "chipFn": "(kg,lb)=>'see table'",
      "bodyFn": "(kg,lb)=>{var r=70*Math.pow(kg,0.75);var k=[['Weight loss (overweight)',0.8],['Obese prone',1.0],['Weight gain (neutered)',1.47],['Weight gain (intact)',1.7],['Light / active working',1.6],['Typical intact pet',1.4],['Typical neutered pet',1.2],['Critical care',1.0],['Healthy kitten',2.5]];return k.map(function(x){return x[0]+' (k='+x[1]+') &rarr; <strong>'+R2(x[1]*r)+' kcal/day</strong>';}).join('<br>');}",
      "lineFn": "(kg,lb)=>'maintenance energy requirement = k x '+R2(70*Math.pow(kg,0.75))+' kcal/day'"
    },
    {
      "id": "water_cat",
      "sp": "cat",
      "grp": "Water intake",
      "name": "Expected water intake — cat",
      "type": "protocol",
      "chipFn": "(kg,lb)=>R2(kg*100)+' ml/day = PU/PD'",
      "bodyFn": "(kg,lb)=>'Water intake is about <strong>1 ml per kcal</strong>.<br>PU/PD threshold is over 100 ml/kg/day = <strong>'+R2(kg*100)+' ml/day</strong> = <strong>'+R2(kg*100/236.6)+' cups/day</strong>.'",
      "lineFn": "(kg,lb)=>'PU/PD threshold '+R2(kg*100)+' ml/day (100 ml/kg/day)'"
    }
