    ]
  },
  "dischargeBlocks": [],
  "aliases": [
    "PU/PD",
    "Water Intake, Water Dep Test"
  ],
  "calculators": [
    {
      "id": "energy",
      "title": "Energy Requirement Calculator",
      "sub": "(k values from Merk and VIN).",
      "inputs": [
        {
          "id": "kcal",
          "label": "Kcal per cup/can",
          "default": 214,
          "step": 1
        }
      ],
      "fn": "(kg,lb,sp,v)=>{\n  const RER=70*Math.pow(kg,0.75), cup=(v.kcal>0?v.kcal:214);\n  const R=x=>Math.round(x), R1=x=>Math.round(x*10)/10;\n  const out=[];\n  out.push([\"Resting Energy Requirement = 70 * Weight(kg)^0.75\", \"RER =\", R(RER), \"kcal/day\"]);\n  out.push([\"Maintenance ER = k * ER\"]);\n  if(sp===\"dog\"){\n    out.push({cols:[\"Condition\",\"k Dog\",\"kcal/day\",\"# cup/can\",\"Water (cups/day)\"]});\n    const T=[[\"Typical Neutered Pet\",1.6],{h:\"Weight management\"},[\"Wt loss (overweight)\",1],\n      [\"Obese Prone\",1.4],[\"Wt Gain (neutered)\",2],[\"Wt Gain (intact)\",2.2],\n      {h:\"Working\"},[\"Light\",2],[\"Moderate\",3],[\"Heavy\",6],\n      {h:\"Typical Pet\"},[\"Intact\",1.8],[\"Neutered\",1.6],[\"Obese Prone\",1.4],[\"Critical Care\",1],\n      {h:\"Healthy Puppies\"},[\"< 16 weeks\",3],[\"> 16 weeks\",2],\n      {h:\"Reproduction\"},[\"Late gestation\",3]];\n    for(const t of T){\n      if(t.h){out.push(t);continue;}\n      const kc=RER*t[1];\n      out.push([t[0],t[1],R(kc),R1(kc/cup),R1(kc/236)+\" +- \"+R1(kc/236/5)]);}\n  }else{\n    out.push({cols:[\"Condition\",\"k Cat\",\"MER\",\"# cups/can\"]});\n    const T=[{h:\"Weight management\"},[\"Wt loss (overweight)\",0.8],[\"Obese Prone\",1],\n      [\"Wt Gain (neutered)\",1.47],[\"Wt Gain (intact)\",1.7],\n      {h:\"Working\"},[\"Light/Active\",1.6],\n      {h:\"Typical Pet\"},[\"Intact\",1.4],[\"Neutered\",1.2],[\"Obese Prone\",1],[\"Critical Care\",1],\n      {h:\"Healthy Kittens\"},[\"< 16 weeks\",2.5],[\"> 16 weeks\",2.5],\n      {h:\"Reproduction\"},[\"Late gestation\",\"unknown\"]];\n    for(const t of T){\n      if(t.h){out.push(t);continue;}\n      if(typeof t[1]!==\"number\"){out.push([t[0],t[1]]);continue;}\n      const kc=RER*t[1];\n      out.push([t[0],t[1],R(kc),R1(kc/cup)]);}\n  }\n  out.push({h:\"Water\"});\n  out.push([\"Water Intake = 1 ml per kcal\"]);\n  out.push([\"pu/pd \\u2261 over 100 ml/kg/day =\", R(kg*100)+\" ml per day =\", R1(kg*100/236.6), \"cups per day\"]);\n  return out;}"
    },
    {
      "id": "lact",
      "title": "Lactation Calorie Requirements ( table from VIN)",
      "inputs": [
        {
          "id": "n",
          "label": "Number of puppies / kittens",
          "default": 4,
          "step": 1
        },
        {
          "id": "week",
          "label": "Week",
          "default": 4,
          "step": 1
        }
      ],
      "fn": "(kg,lb,sp,v)=>{\n  const RER=70*Math.pow(kg,0.75), R=x=>Math.round(x), R2=x=>Math.round(x*100)/100;\n  const n=Math.round(v.n), wk=Math.round(v.week);\n  const out=[];\n  if(sp===\"dog\"){\n    const N={1:24,2:48,3:72,4:96,5:108,6:120,7:132,8:144}, L={1:0.75,2:0.95,3:1.1,4:1.2};\n    const nn=N[Math.min(Math.max(n,1),8)], ll=L[Math.min(Math.max(wk,1),4)];\n    out.push([\"Dog\",\"145/70 * RER + (n * BW * L)\"]);\n    out.push([\"n =\",nn,\"(look-up table depends on # in litter)\"]);\n    out.push([\"L =\",ll,\"(look-up table depends on age of pups/kittens)\"]);\n    const cal=145/70*RER+nn*kg*ll, reg=RER*1.8;\n    out.push([\"Dog:\",R(cal),\"cal/day\"]);\n    out.push([\"Reg MER\",R2(reg),\"Increase feeding by\",R2(cal/reg)]);\n  }else{\n    const nn=n<3?18:(n<=4?60:70), L={1:0.9,2:0.9,3:1.2,4:1.2,5:1.1,6:1,7:0.8};\n    const ll=L[Math.min(Math.max(wk,1),7)];\n    out.push([\"Cat\",\"100 * BW ^.67 + (n * BW * L)\"]);\n    out.push([\"n =\",nn,\"(look-up table depends on # in litter)\"]);\n    out.push([\"L =\",ll,\"(look-up table depends on age of pups/kittens)\"]);\n    const cal=100*Math.pow(kg,2/3)+nn*kg*ll, reg=RER*1.4;\n    out.push([\"Cat\",R(cal),\"cal/day\"]);\n    out.push([\"Reg MER\",R2(reg),\"Increase feeding by\",R2(cal/reg)]);\n  }\n  return out;}"
    },
    {
      "id": "osm",
      "title": "Calculated Osmolality",
      "needsWeight": false,
      "inputs": [
        {
          "id": "na",
          "label": "Na",
          "step": 1
        },
        {
          "id": "glu",
          "label": "Glucose",
          "step": 1
        },
        {
          "id": "bun",
          "label": "BUN",
          "step": 1
        }
      ],
      "fn": "(kg,lb,sp,v)=>{\n  const na=v.na, glu=v.glu, bun=v.bun;\n  if(!(na>0&&glu>0))return[[\"Enter Na and Glucose.\"]];\n  const R=x=>Math.round(x);\n  const corr=1.6*((glu-100)/100)+na;\n  const out=[];\n  out.push([\"Na\",na]);\n  out.push([\"Corrected Na\",R(corr),\"Na + (Glucose-100)/100*1.6\"]);\n  out.push([\"Glucose\",glu]);\n  out.push([\"BUN\",bun>0?bun:\"\"]);\n  if(bun>0)out.push([\"Calculated Osmolality:\",R(2*corr+glu/18+bun/2.8),\"2(Na+) + [glucose/18] + [BUN/2.8]\"]);\n  out.push([\"Calculated Osmolality:\",R(2*corr+glu/18),\"2(Na) + Glucose/18\"]);\n  out.push([\"Normal osmolality for dog = 280 to 310, cat = 180 to 310\"]);\n  out.push([\"Water Dep test: d/c if Na > 165 or osmolality > 350\"]);\n  return out;}"
    },
    {
      "id": "wdep",
      "title": "Water Dep test",
      "inputs": [
        {
          "id": "w0",
          "label": "Initial Weight (Day 0)",
          "unit": "lbs",
          "step": 0.1
        },
        {
          "id": "i0",
          "label": "Initial Water Intake (Day 0)",
          "unit": "cups/day",
          "step": 0.5
        }
      ],
      "fn": "(kg,lb,sp,v)=>{\n  const w0=v.w0>0?v.w0:lb, i0=v.i0;\n  const R1=x=>Math.round(x*10)/10, R2=x=>Math.round(x*100)/100;\n  const out=[];\n  out.push([\"Initial Weight (Day 0)\",R1(w0),\"lbs\"]);\n  if(i0>0)out.push([\"Initial Water Intake (Day 0)\",i0,\"cups/day\"]);\n  out.push({h:\"End if\"});\n  out.push([\"SpG  >\",1.025]);\n  out.push([\"5 % weight loss, weight <=\",R1(w0*0.9),\"lb\"]);\n  out.push([\"Water intake <= 60/ml/kg/day\",R1(w0/2.2*60/236),\"cups/day\"]);\n  out.push([\"Na >\",165]);\n  out.push([\"Osmolality >\",\"350 (use table above)\"]);\n  out.push({h:\"Gradual Water Dep Test\"});\n  out.push([\"Measure water intake daily 3-5 days for average\"]);\n  out.push([\"Weigh, check SpG on day 1 before water deprivation\"]);\n  out.push([\"Each AM:  check weight, SpG & Na\"]);\n  out.push([\"Reduce water  by 5 to 10% each day\",i0>0?R2(i0/20):\"\",\"c/day (= 5%)\"]);\n  out.push([\"If the patient becomes 5% dehydrated or loses 5% body weight, empty the bladder and check USG.\"]);\n  out.push([\"Administer DDAVP at 4 drops of 100 \\u00b5g/mL solution either intranasally or into the conjunctival sac.\"]);\n  out.push([\"Hospitalize the patient and check USG in 3 hours.8 If USG is >1.025, the diagnosis is CDI. If USG is <1.025, NDI is the most likely diagnosis\"]);\n  return out;}"
    }
  ]
}
