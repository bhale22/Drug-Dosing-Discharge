    {
      "id": "maint_dog",
      "sp": "dog",
      "grp": "Maintenance",
      "name": "Maintenance rate — dog",
      "type": "protocol",
      "chipFn": "(kg,lb)=>R2(kg*60/24)+' ml/hr'",
      "bodyFn": "(kg,lb)=>'60 ml/kg/day = <strong>'+R2(kg*60)+' ml/day</strong> = <strong>'+R2(kg*60/24)+' ml/hr</strong>.<br>Twice maintenance = '+R2(kg*120/24)+' ml/hr ('+R2(kg*120)+' ml/day).'",
      "lineFn": "(kg,lb)=>'maintenance fluids '+R2(kg*60/24)+' ml/hr (60 ml/kg/day)'",
      "inClinic": true
    },
    {
      "id": "deficit_dog",
      "sp": "dog",
      "grp": "Dehydration deficit",
      "name": "Deficit by % dehydration — dog",
      "type": "protocol",
      "chipFn": "(kg,lb)=>'see table'",
      "bodyFn": "(kg,lb)=>{var p=[3,5,7,9,11];return '<strong>Deficit (ml) = % dehydration &times; kg &times; 10</strong><br>'+p.map(function(x){var d=x*kg*10;return x+'% &rarr; <strong>'+R2(d)+' ml</strong> &nbsp;(over 6 h '+R2(d/6)+', 8 h '+R2(d/8)+', 12 h '+R2(d/12)+', 24 h '+R2(d/24)+' ml/hr)';}).join('<br>');}",
      "lineFn": "(kg,lb)=>'dehydration deficit = % x '+R2(kg*10)+' ml per 1%'",
      "inClinic": true
    },
