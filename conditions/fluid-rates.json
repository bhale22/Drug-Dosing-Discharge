          ],
          [],
          [
            {
              "c": 1,
              "t": "Lester Mandelker's SQ Fluids/Furosemide Protocol",
              "b": true
            }
          ],
          [
            {
              "c": 1,
              "t": "Hospitalize cat for 1-2 days and treat intensely to lower BUN/creatinine",
              "b": false
            }
          ],
          [
            {
              "c": 1,
              "t": "Start with SQ fluids ie lactated ringers",
              "b": false
            }
          ],
          [
            {
              "c": 1,
              "t": "Give 200ml SQ every 3-4 hours for a day total of 600-900ml",
              "b": false
            }
          ],
          [
            {
              "c": 1,
              "t": "EACH TIME you must give SQ furosemide ie 0.2ml - 0.3ml at the same time",
              "b": false
            }
          ],
          [
            {
              "c": 1,
              "t": "Furosemide paralyzes the sodium/potassium pump forcing",
              "b": false
            }
          ],
          [
            {
              "c": 1,
              "t": "sodium to be excreted taking all the SQ fluids with it.",
              "b": false
            }
          ],
          [
            {
              "c": 1,
              "t": "This fluids is flushed out with the urea toxins out of the body almost",
              "b": false
            }
          ],
          [
            {
              "c": 1,
              "t": "immediately as cat will urinate a ton :)",
              "b": false
            }
          ],
          [
            {
              "c": 1,
              "t": "The reason why furosemide is given every time is that",
              "b": false
            }
          ],
          [
            {
              "c": 1,
              "t": "the paralysis effect to excrete sodium only lasts for 2 -4 hrs.",
              "b": false
            }
          ],
          [
            {
              "c": 1,
              "t": "About the half/ life of furosemide....",
              "b": false
            }
          ],
          [],
          [
            {
              "c": 1,
              "t": "I have never seen pulmonary edema develop nor will it",
              "b": false
            }
          ],
          [
            {
              "c": 1,
              "t": "appreciably alter blood pressure. Fluids increase BP",
              "b": false
            }
          ],
          [
            {
              "c": 1,
              "t": "while furosemide decreases BP so they cancel each other",
              "b": false
            }
          ],
          [
            {
              "c": 1,
              "t": "out. Give your standard dose of amlopidine that day.",
              "b": false
            }
          ],
          [],
          [
            {
              "c": 1,
              "t": "This procedure works in 1 or 2 days...no longer is needed.",
              "b": false
            }
          ],
          [
            {
              "c": 1,
              "t": "Once BUN/creatinine return to more normal levels..send",
              "b": false
            }
          ],
          [
            {
              "c": 1,
              "t": "cat home on a can food diet ( better lower protein first week or two)",
              "b": false
            }
          ],
          [
            {
              "c": 1,
              "t": "with extra tuna juice etc.to encourage increased fluid intake",
              "b": false
            }
          ],
          [
            {
              "c": 1,
              "t": "Don't give dry....as dry food just dehydrates the cats again....",
              "b": false
            }
          ]
        ]
      }
