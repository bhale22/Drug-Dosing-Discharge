          [
            {
              "c": 3,
              "t": "The Droncit at higher doses for 3 consecutive days only caused her to skip shedding tapeworms for one day.",
              "b": false
            }
          ],
          [
            {
              "c": 3,
              "t": "I spoke to the parasitologist at VaTech who recommended using Panacur at 100 mg/kg sid x 6 days. The rationale for this is that in Europe, mebendazole has been shown effective against dipilydium. Panacur didn't work against it in trials here, but the company did not attempt to test it at higher doses.",
              "b": false
            }
          ],
          [
            {
              "c": 3,
              "t": "Pet finished the course 7 days ago, and has not shed any worms since day 2 of the regimen.",
              "b": false
            }
          ],
          [
            {
              "c": 3,
              "t": "I will update further if the tapeworms recur, but wanted to get it out there that panacur at higher doses may work.",
              "b": false
            }
          ],
          [],
          [
            {
              "c": 3,
              "t": "Good deal, thanks for updating. Panacur has a 100 mg/kg label dose in Europe for one dose instead of 3.",
