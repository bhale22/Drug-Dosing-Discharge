  "dischargeBlocks": [
    {"id":"inhosp","title":"Treatments given in clinic","dischargeOnly":true,"on":true,
      "text":"The following treatments were given in hospital today. Please see your medication list above for any take-home medications."},
    {"id":"withhold_water","title":"☐  Withhold water for 2 hours","dischargeOnly":true,"on":false,
      "checkbox":true,
      "text":"Withhold water for 2 hours to allow the Cerenia injection time to prevent vomiting."},
    {"id":"withhold_food","title":"☐  Withhold food","dischargeOnly":true,"on":false,
      "checkbox":true,
      "durationOptions":["4 hours","8 hours","12 hours","24 hours"],
      "text":"Withhold food for {duration} to allow stomach and intestinal inflammation to lessen. It is OK to hide pills in a small treat and give these during the fasting period if needed."},
    {"id":"small_meals","title":"☐  Offer small meals / bland diet","dischargeOnly":true,"on":false,
      "checkbox":true,
      "text":"Offer very small meals of a bland diet until no vomiting for 3 days, then transition back to the regular diet over 2 to 3 days."},
    {"id":"bath","title":"Bathing / topical care","dischargeOnly":false,"on":false,
      "text":"Bathe with the prescribed medicated shampoo, allowing 10 minutes of contact time before rinsing thoroughly. Repeat as directed."},
    {"id":"meds","title":"Giving medications","dischargeOnly":false,"on":false,
      "text":"It is OK to hide pills in a small treat or pill pocket. If any medication causes vomiting or {name} refuses food, please call us before continuing."},
    {"id":"followup","title":"Follow up","dischargeOnly":false,"on":true,
      "text":"Please give us a call in 10 to 14 days to let us know how {name} is coming along. If the itching, redness, or skin lesions are not improving — or are getting worse — please call us right away so we can re-evaluate."}
  ]
